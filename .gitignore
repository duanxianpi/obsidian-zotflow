# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# esbuild
meta.json

# CSL test fixtures (downloaded on first test run)
tests/.csl-fixtures/

# vitest coverage reports
coverage/

# Full-repo lint output. A scratch snapshot of the backlog, regenerated on
# demand with `npx eslint .` — it goes stale the moment a rule or a plugin
# version moves, so it is not worth versioning. The lint that actually gates
# is `lint:convert`, which runs at --max-warnings 0.
lint.txt
